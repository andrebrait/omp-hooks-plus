{
  "name": "omp-hooks-plus",
  "version": "0.1.0",
  "description": "Install-once Claude Code hook compatibility for OMP",
  "type": "module",
  "keywords": [
    "omp",
    "oh-my-pi",
    "omp-package",
    "extension",
    "hooks",
    "command-hooks",
    "claude-code",
    "claude-code-hooks"
  ],
  "license": "MIT",
  "author": "Andre Brait",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrebrait/omp-hooks-plus.git"
  },
  "bugs": {
    "url": "https://github.com/andrebrait/omp-hooks-plus/issues"
  },
  "homepage": "https://github.com/andrebrait/omp-hooks-plus#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/omp-hooks.ts --target=bun --outdir=dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run typecheck && bun run build"
  },
  "omp": {
    "extensions": [
      "./src/omp-hooks.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./src/omp-hooks.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.0.5"
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.0.5",
    "typescript": "^6.0.2"
  }
}